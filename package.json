{
  "name": "deep-peak-hours-tracker",
  "displayName": "Deep Peak Hours Tracker",
  "description": "Unofficial DeepSeek peak/off-peak hours tracker in the VS Code status bar",
  "version": "0.1.0",
  "publisher": "mervick",
  "author": {
    "name": "Andrey Izman",
    "email": "izmanw@gmail.com",
    "url": "https://github.com/mervick"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mervick/deepseek-peak-hours.git"
  },
  "bugs": {
    "url": "https://github.com/mervick/deepseek-peak-hours/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "deep-peak-hours-tracker-logo": {
        "description": "Deep Peak Hours Tracker logo",
        "default": {
          "fontPath": "./media/icon.ttf",
          "fontCharacter": "\\E001"
        }
      }
    },
    "configuration": {
      "title": "Deep Peak Hours Tracker",
      "properties": {
        "deep-peak-hours-tracker.notifications": {
          "order": 1,
          "type": "boolean",
          "default": true,
          "title": "%deep-peak-hours-tracker.config.notifications.title%",
          "description": "%deep-peak-hours-tracker.config.notifications.description%"
        },
        "deep-peak-hours-tracker.peakSoonMinutes": {
          "order": 2,
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 30,
          "title": "%deep-peak-hours-tracker.config.peakSoonMinutes.title%",
          "description": "%deep-peak-hours-tracker.config.peakSoonMinutes.description%"
        },
        "deep-peak-hours-tracker.peakTransitionBufferMinutes": {
          "order": 3,
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 20,
          "title": "%deep-peak-hours-tracker.config.peakTransitionBufferMinutes.title%",
          "description": "%deep-peak-hours-tracker.config.peakTransitionBufferMinutes.description%"
        },
        "deep-peak-hours-tracker.postPeakMinutes": {
          "order": 4,
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 20,
          "title": "%deep-peak-hours-tracker.config.postPeakMinutes.title%",
          "description": "%deep-peak-hours-tracker.config.postPeakMinutes.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && esbuild out/*.js --outdir=out --sourcemap --allow-overwrite",
    "watch": "tsc -watch -p ./",
    "build": "rm -rf out && npm run compile && npx --yes @vscode/vsce package --no-dependencies",
    "publish": "rm -rf out && npm run compile && npx --yes @vscode/vsce publish",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.0"
  }
}
